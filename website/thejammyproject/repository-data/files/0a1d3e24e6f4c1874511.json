{"content":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Repository — James Shaw</title>\n  <meta name=\"description\" content=\"Browse James Shaw's public infrastructure and automation portfolio without leaving The Jammy Project.\" />\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/styles/github-dark.min.css\">\n  <link rel=\"stylesheet\" href=\"styles.css\">\n  <link rel=\"stylesheet\" href=\"repository.css\">\n</head>\n<body>\n  <header>\n    <div class=\"container nav\">\n      <a class=\"brand\" href=\"index.html\" aria-label=\"The Jammy Project home\">\n        <img src=\"images/tjp-logo.png\" alt=\"\" />\n        <span>JAMES SHAW</span>\n      </a>\n      <button class=\"hamburger\" id=\"navToggle\" aria-expanded=\"false\" aria-controls=\"site-menu\" aria-label=\"Toggle menu\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 6h18M3 12h18M3 18h18\"/></svg>\n      </button>\n      <nav class=\"menu\" id=\"site-menu\" aria-label=\"Site navigation\">\n        <a href=\"index.html#about\">About</a>\n        <a href=\"index.html#skills\">Skills</a>\n        <a href=\"index.html#projects\">Projects</a>\n        <a href=\"repository.html\" aria-current=\"page\">Repository</a>\n        <a href=\"index.html#contact\">Contact</a>\n      </nav>\n    </div>\n  </header>\n\n  <main class=\"container repository-page\">\n    <section class=\"repository-hero\" aria-labelledby=\"repository-title\">\n      <p class=\"chip\">Public repository · Read only</p>\n      <div class=\"repository-heading\">\n        <div>\n          <h1 id=\"repository-title\">Cloud & Infrastructure Portfolio</h1>\n          <p class=\"muted\" id=\"repository-description\">Loading repository information…</p>\n        </div>\n        <a class=\"btn\" id=\"repository-github-link\" href=\"https://github.com/thejammyproject/tjp-public-repo\" target=\"_blank\" rel=\"noreferrer\">View on GitHub ↗</a>\n      </div>\n      <div class=\"repository-meta\" id=\"repository-meta\" aria-live=\"polite\"></div>\n      <div class=\"chiprow\" id=\"repository-technologies\" aria-label=\"Technologies\"></div>\n    </section>\n\n    <section class=\"repository-browser\" aria-labelledby=\"browser-title\">\n      <div class=\"browser-toolbar\">\n        <div>\n          <p class=\"eyebrow\" id=\"browser-title\">Repository browser</p>\n          <nav class=\"breadcrumbs\" id=\"breadcrumbs\" aria-label=\"Repository breadcrumbs\"></nav>\n        </div>\n        <a class=\"github-file-link\" id=\"current-github-link\" href=\"https://github.com/thejammyproject/tjp-public-repo\" target=\"_blank\" rel=\"noreferrer\">Open current location on GitHub ↗</a>\n      </div>\n\n      <div class=\"browser-layout\">\n        <aside class=\"repository-navigation\" aria-label=\"Files and directories\">\n          <button class=\"parent-link\" id=\"parent-link\" type=\"button\" hidden>← Parent directory</button>\n          <div class=\"browser-status\" id=\"directory-status\" role=\"status\">Loading repository…</div>\n          <ul class=\"directory-list\" id=\"directory-list\"></ul>\n        </aside>\n\n        <article class=\"file-panel\" id=\"file-panel\" aria-live=\"polite\">\n          <div class=\"empty-state\">\n            <span class=\"empty-icon\" aria-hidden=\"true\">⌁</span>\n            <h2>Select a file</h2>\n            <p>Choose a file from the repository to inspect its contents.</p>\n          </div>\n        </article>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"container\">\n      <div>© <span id=\"year\"></span> James Shaw • The Jammy Project</div>\n      <div class=\"muted\">Static, fast, and privacy-friendly. No cookies. No tracking.</div>\n    </div>\n  </footer>\n\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/highlight.min.js\" defer></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/marked@18.0.7/lib/marked.umd.js\" defer></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/dompurify@3.4.14/dist/purify.min.js\" defer></script>\n  <script src=\"main.js\" defer></script>\n  <script type=\"module\" src=\"repository.js\"></script>\n</body>\n</html>\n"}
